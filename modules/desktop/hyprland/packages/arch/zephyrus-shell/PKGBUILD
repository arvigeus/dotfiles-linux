pkgname=zephyrus-shell
pkgver=20261002.r16.g33eba4c
pkgrel=1
pkgdesc='Zephyrus Quickshell desktop and Hyprland session'
arch=('any')
makedepends=('git')
url='https://github.com/arvigeus/zephyrus-shell'
license=('LicenseRef-Zephyrus')
# No revision selector: makepkg refreshes the public repository HEAD each build.
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
	cd "$srcdir/zephyrus-shell"
	printf '%s.r%s.g%s' "$(git log -1 --format=%cd --date=format:%Y%m%d)" \
		"$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

package() {
	cd "$srcdir/zephyrus-shell"
	install -d "$pkgdir/usr/share/zephyrus-shell"
	git archive HEAD | tar -x -C "$pkgdir/usr/share/zephyrus-shell"
	git rev-parse HEAD >"$pkgdir/usr/share/zephyrus-shell/REVISION"
	install -Dm644 systemd/user/zephyrus-clipboard@.service "$pkgdir/usr/lib/systemd/user/zephyrus-clipboard@.service"
	install -Dm755 scripts/cpu-boost.py "$pkgdir/usr/lib/zephyrus-shell/cpu-boost"
	install -Dm644 system/org.zephyrus-shell.cpu-boost.policy "$pkgdir/usr/share/polkit-1/actions/org.zephyrus-shell.cpu-boost.policy"
}
