#!/usr/bin/env bash
## Claude Code terminal coding assistant
## Disabled: rename this file to ai-assistant.sh to enable it.
set -Eeuo pipefail

source "$SETUP_ROOT/lib/module.sh"

case "$DISTRO" in
arch)
	pkg_install arch:aur/claude-code
	;;
fedora)
	# Anthropic stable RPM channel. Published signing-key fingerprint:
	# 31DD DE24 DDFA B679 F42D 7BD2 BAA9 29FF 1A7E CACE
	file_write /etc/yum.repos.d/claude-code.repo <<'EOF'
[claude-code]
name=Claude Code
baseurl=https://downloads.claude.ai/claude-code/rpm/stable
enabled=1
gpgcheck=1
repo_gpgcheck=0
gpgkey=https://downloads.claude.ai/keys/claude-code.asc
EOF
	pkg_install fedora:claude-code
	;;
esac
