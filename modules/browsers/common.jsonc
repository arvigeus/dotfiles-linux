{
  "extensions": [
    {
      "name":     "Bitwarden",
      "firefox":  "https://addons.mozilla.org/firefox/downloads/file/4410896/bitwarden_password_manager-latest.xpi",
      "chromium": "https://chromewebstore.google.com/detail/bitwarden-password-manage/nngceckbapebfimnlniiiahkandclblb"
    },
    {
      "name":     "uBlock Origin",
      "firefox":  "https://addons.mozilla.org/firefox/downloads/file/4492375/ublock_origin-latest.xpi",
      "chromium": "https://chromewebstore.google.com/detail/ublock-origin-lite/ddkjiahejlhfcafbddmgiahcphecmpfh"
      // `Settings -> Filter lists` and enable `Annoyances`, `Cookie Notices` and etc. Press `Update now`, then `Apply Changes`.
    },
    {
      "name":     "Multi-Account Containers",
      "firefox":  "https://addons.mozilla.org/firefox/downloads/file/4494279/multi_account_containers-latest.xpi"
    },
    {
      "name":                 "Export Cookies",
      "firefox":              "https://addons.mozilla.org/firefox/downloads/file/3403419/export_cookies_txt-latest.xpi",
      "firefox_id_fallback":  "{36bdf805-c6f2-4f41-94d2-9b646342c1dc}",
      "chromium":             "https://chromewebstore.google.com/detail/get-cookiestxt-locally/cclelndahbckbenkjhflpdbgdldlbecc"
    },
    {
      "name":     "Picture-in-Picture",
      "chromium": "https://chromewebstore.google.com/detail/picture-in-picture-extens/hkgfoiooedgoejojocmhlaklaeopbecg"
    },
    {
      "name":     "Plasma Integration",
      "firefox":  "https://addons.mozilla.org/firefox/downloads/file/4298512/plasma_integration-latest.xpi",
      "chromium": "https://chromewebstore.google.com/detail/plasma-integration/cimiefiiaegbelhefglklhhakcgmhkai"
    },
    {
      "name":     "React Dev Tools",
      "firefox":  "https://addons.mozilla.org/firefox/downloads/file/4360002/react_devtools-latest.xpi",
      "chromium": "https://chromewebstore.google.com/detail/react-developer-tools/fmkadmapgofadopljbjfkapdkoienihi"
    },
    {
      "name":     "Wappalyzer",
      "firefox":  "https://addons.mozilla.org/firefox/downloads/file/4482384/wappalyzer-latest.xpi",
      "chromium": "https://chromewebstore.google.com/detail/wappalyzer-technology-pro/gppongmhjkpfnbhagpmjfkannfbllamg"
    },
    {
      "name":     "Web Developer",
      "firefox":  "https://addons.mozilla.org/firefox/downloads/file/4306323/web_developer-latest.xpi",
      "chromium": "https://chromewebstore.google.com/detail/web-developer-tool-for-ch/ghenifimhcdihapkceohjpgiabidpgji"
    },
    {
      "name":     "WebHint",
      "firefox":  "https://addons.mozilla.org/firefox/downloads/file/4344764/webhint-latest.xpi",
      "chromium": "https://chromewebstore.google.com/detail/webhint/gccemnpihkbgkdmoogenkbkckppadcag"
    },
    {
      "name":     "SponsorBlock",
      "firefox":  "https://addons.mozilla.org/firefox/downloads/file/4480833/sponsorblock-latest.xpi",
      "chromium": "https://chromewebstore.google.com/detail/sponsorblock-for-youtube/mnjggcdmjocbbbhaepdhchncahnbgone"
    },
    {
      "name":     "Language Tool",
      "firefox":  "https://addons.mozilla.org/firefox/downloads/file/4470413/languagetool-latest.xpi",
      "chromium": "https://chromewebstore.google.com/detail/ai-grammar-checker-paraph/oldceeleldhonbafppcapldpdifcinji"
    },
    {
      "name":     "The Camelizer",
      "firefox":  "https://addons.mozilla.org/firefox/downloads/file/4075638/the_camelizer_price_history_ch-latest.xpi",
      "chromium": "https://chromewebstore.google.com/detail/the-camelizer/ghnomdcacenbmilgjigehppbamfndblo"
    },
    {
      "name":     "Unhook",
      "firefox":  "https://addons.mozilla.org/firefox/downloads/file/4733035/youtube_recommended_videos-latest.xpi",
      "chromium": "https://chromewebstore.google.com/detail/unhook-remove-youtube-rec/khncfooichmfjbepaaaebmommgaepoid"
    }
  ],
  "search_engines": {
    "app_engines": [
      {"id": "google",    "name": "Google"},
      {"id": "bing",      "name": "Bing"},
      {"id": "ddg",       "name": "DuckDuckGo"},
      {"id": "wikipedia", "name": "Wikipedia (en)"}
    ],
    "common_engines": [
      {
        "name":     "Qwant",
        "icon":     "https://www.qwant.com/favicon.ico",
        "template": "https://www.qwant.com/?q={searchTerms}",
        "alias":    "@qwant"
      },
      {
        "name":     "Ecosia",
        "icon":     "https://www.ecosia.org/static/icons/favicon.ico",
        "template": "https://www.ecosia.org/search?q={searchTerms}",
        "alias":    "@ecosia"
      },
      {
        "name":     "SourceGraph",
        "icon":     "https://sourcegraph.com/favicon.ico",
        "template": "https://sourcegraph.com/search?q=context:global+fork:no+{searchTerms}",
        "alias":    "@code"
      },
      {
        "name":     "pkgs.org",
        "icon":     "https://pkgs.org/favicon.ico",
        "template": "https://pkgs.org/search/?q={searchTerms}",
        "alias":    "@pkgs"
      }
    ],
    "distro_engines": {
      "arch": [
        {
          "name":     "Chaotic AUR",
          "icon":     "https://aur.chaotic.cx/favicon-16x16.png",
          "template": "https://aur.chaotic.cx/packages?search={searchTerms}",
          "alias":    "@chaotic"
        },
        {
          "name":     "Arch Wiki",
          "icon":     "https://archlinux.org/favicon.ico",
          "template": "https://wiki.archlinux.org/index.php?search={searchTerms}",
          "alias":    "@archwiki"
        },
        {
          "name":     "Arch AUR",
          "icon":     "https://archlinux.org/favicon.ico",
          "template": "https://aur.archlinux.org/packages?K={searchTerms}",
          "alias":    "@aur"
        },
        {
          "name":     "Arch",
          "icon":     "https://archlinux.org/favicon.ico",
          "template": "https://archlinux.org/packages/?q={searchTerms}",
          "alias":    "@arch"
        }
      ],
      "fedora": [
        {
          "name":     "Fedora Packages",
          "icon":     "https://fedoraproject.org/favicon.ico",
          "template": "https://packages.fedoraproject.org/search?query={searchTerms}",
          "alias":    "@fedora"
        },
        {
          "name":     "Terra",
          "icon":     "https://terra.fyralabs.com/favicon.ico",
          "template": "https://github.com/search?q=repo%3Aterrapkg%2Fpackages+{searchTerms}&type=code",
          "alias":    "@terra"
        },
        {
          "name":     "COPR",
          "icon":     "https://copr.fedorainfracloud.org/favicon.ico",
          "template": "https://copr.fedorainfracloud.org/coprs/fulltext/?fulltext={searchTerms}",
          "alias":    "@copr"
        },
        {
          "name":     "RPM Fusion",
          "icon":     "https://rpmfusion.org/favicon.ico",
          "template": "https://admin.rpmfusion.org/pkgdb/packages/?pattern={searchTerms}",
          "alias":    "@rpmfusion"
        }
      ]
    }
  }
}
