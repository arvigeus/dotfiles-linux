#!/usr/bin/env bash
# On-demand Vietnamese input. Idle status never contacts the input daemon.
set -Eeuo pipefail

config_dir=${XDG_CONFIG_HOME:-$HOME/.config}
notify=false
rollback=false
kind=
directory=

run() { timeout --foreground 10s "$@"; }
fail() {
	printf '%s\n' "$*" >&2
	return 1
}
on_error() {
	local code=$? command=$BASH_COMMAND
	trap - ERR
	if [[ $rollback == true ]]; then
		rollback=false
		stop_input || true
	fi
	printf 'Input method failed: %s\n' "$command" >&2
	if [[ $notify == true ]] && command -v notify-send >/dev/null; then
		notify-send 'Input method' "Could not change input language. $command" || true
	fi
	exit "$code"
}
trap on_error ERR

write_file() {
	local path=$1
	mkdir -p -- "$(dirname -- "$path")"
	cat >"$path.tmp"
	mv -f -- "$path.tmp" "$path"
}

# Update one INI key while retaining unrelated settings and comments. Empty
# section names select the root options used by UniKey and the Wayland addon.
ini_set() {
	local path=$1 section=$2 key=$3 value=$4
	mkdir -p -- "$(dirname -- "$path")"
	[[ -e $path ]] || : >"$path"
	awk -v section="$section" -v key="$key" -v value="$value" '
	BEGIN { active = section == ""; found = active }
	/^\[/ {
		if (active && !written) { print key "=" value; written = 1 }
		active = $0 == "[" section "]"
		if (active) found = 1
	}
	active && index($0, key "=") == 1 {
		if (!written) { print key "=" value; written = 1 }
		next
	}
	{ print }
	END {
		if (!found) print "\n[" section "]"
		if (!written) print key "=" value
	}' "$path" >"$path.tmp"
	mv -f -- "$path.tmp" "$path"
}

ini_list() {
	local path=$1 section=$2
	shift 2
	awk -v section="$section" '
	/^\[/ { skip = $0 == "[" section "]" }
	!skip { print }
	' "$path" >"$path.tmp"
	{
		printf '\n[%s]\n' "$section"
		local index=0 value
		for value in "$@"; do
			printf '%s=%s\n' "$index" "$value"
			index=$((index + 1))
		done
	} >>"$path.tmp"
	mv -f -- "$path.tmp" "$path"
}

configure() {
	local desktop=$1 root="$config_dir/fcitx5"
	[[ $desktop == hyprland || $desktop == plasma ]] || fail 'configure requires plasma or hyprland'
	write_file "$root/profile" <<'PROFILE'
[Groups/0]
Name=Vietnamese
Default Layout=us
DefaultIM=unikey

[Groups/0/Items/0]
Name=keyboard-us
Layout=

[Groups/0/Items/1]
Name=unikey
Layout=

[GroupOrder]
0=Vietnamese
PROFILE
	ini_set "$root/config" Behavior ShareInputState All
	ini_set "$root/config" Behavior ActiveByDefault True
	ini_set "$root/config" Behavior ShowInputMethodInformation False
	if [[ $desktop == hyprland ]]; then
		ini_list "$root/config" Hotkey/TriggerKeys Alt+Shift_L Alt+Shift_R Shift+Alt_L Shift+Alt_R
	else
		ini_list "$root/config" Hotkey/TriggerKeys Control+space
	fi
	# Plain Shift and Super+Space must not introduce additional toggles.
	ini_list "$root/config" Hotkey/AltTriggerKeys
	ini_list "$root/config" Hotkey/EnumerateGroupForwardKeys
	ini_list "$root/config" Hotkey/EnumerateGroupBackwardKeys
	ini_set "$root/conf/wayland.conf" '' 'Allow Overriding System XKB Settings' False
	ini_set "$root/conf/unikey.conf" '' InputMethod Telex
	ini_set "$root/conf/unikey.conf" '' OutputCharset Unicode
}

dbus() {
	run gdbus call --session --dest org.freedesktop.DBus \
		--object-path /org/freedesktop/DBus --method "org.freedesktop.DBus.$1" "${@:2}"
}
fcitx_running() {
	local owner
	owner=$(dbus NameHasOwner org.fcitx.Fcitx5) || return
	[[ $owner == *true* ]]
}
vietnamese_available() {
	command -v fcitx5 >/dev/null && command -v fcitx5-remote >/dev/null || return 1
	local path engine=false
	local data_paths="${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
	local -a paths
	IFS=: read -r -a paths <<<"$data_paths"
	for path in "${paths[@]}"; do
		if [[ -r $path/fcitx5/inputmethod/unikey.conf ]]; then engine=true; break; fi
	done
	[[ $engine == true ]] || return 1
	if [[ $kind == hyprland ]]; then
		[[ $(run systemctl --user show system-vietnamese.service --property=LoadState --value) == loaded ]]
	else
		command -v kwriteconfig6 >/dev/null
	fi
}
find_session() {
	case :${XDG_CURRENT_DESKTOP,,}: in
	*:hyprland:*) kind=hyprland ;;
	*:kde:* | *:plasma:*) kind=plasma ;;
	*) fail 'Vietnamese input supports Plasma and Hyprland sessions' ;;
	esac
	local identity
	if [[ $kind == hyprland ]]; then
		identity=${HYPRLAND_INSTANCE_SIGNATURE:?No active Hyprland instance}
	else
		# New KWin bus owner => new session, even with systemd user lingering.
		identity=$(dbus GetNameOwner org.kde.KWin)
	fi
	identity=${identity//[^a-zA-Z0-9_.-]/_}
	directory="${XDG_RUNTIME_DIR:?No graphical session runtime directory}/system-input-method/$kind-$identity"
}
read_secondary() {
	selected='bg'
	if [[ -r $directory/secondary ]]; then
		IFS= read -r selected <"$directory/secondary" || true
	fi
}
hypr_config() {
	local layout=us,bg variant=,phonetic options=terminate:ctrl_alt_bksp,grp:alt_shift_toggle
	if [[ $1 == vi ]]; then
		layout=us variant='' options=terminate:ctrl_alt_bksp
	fi
	local script="hl.config({input={kb_layout=\"$layout\",kb_variant=\"$variant\",kb_options=\"$options\"}})"
	run hyprctl eval "$script" >/dev/null
	# Publish through the shell's public session-layout override. The shell
	# does not read this controller's private runtime files.
	local identity=${HYPRLAND_INSTANCE_SIGNATURE//[^a-zA-Z0-9_.-]/_}
	printf '%s\n' "$script" | write_file "$XDG_RUNTIME_DIR/zephyrus-shell/input-language-$identity.lua"
}
kwin_method() {
	run kwriteconfig6 --file kwinrc --group Wayland --key InputMethod --notify "$1"
	run gdbus call --session --dest org.kde.KWin --object-path /KWin --method org.kde.KWin.reconfigure
}
stop_input() {
	printf 'bg\n' | write_file "$directory/secondary"
	if [[ $kind == plasma ]]; then
		kwin_method '' >/dev/null || return
	elif fcitx_running; then
		# BG can be installed alone, without the Vietnamese unit. An externally
		# started daemon is still stopped through its own exit command below.
		run systemctl --user stop system-vietnamese.service >/dev/null || true
	fi
	if fcitx_running; then
		run fcitx5-remote -e || return
	fi
	local attempt
	for ((attempt = 0; attempt < 50; attempt++)); do
		if ! fcitx_running; then
			[[ $kind != hyprland ]] || hypr_config bg
			return
		fi
		sleep 0.1
	done
	fail 'Fcitx did not stop; keyboard layouts were not changed'
}
activate_vietnamese() {
	# Readiness belongs to the daemon, not the focused widget. A menu, desktop,
	# browser page or password field may have no editable input context at all.
	local attempt group
	for ((attempt = 0; attempt < 50; attempt++)); do
		fcitx_running || fail 'Fcitx stopped before Vietnamese input was ready'
		run fcitx5-remote -g Vietnamese
		run fcitx5-remote -s unikey
		group=$(run gdbus call --session --dest org.fcitx.Fcitx5 --object-path /controller \
			--method org.fcitx.Fcitx.Controller1.FullInputMethodGroupInfo Vietnamese)
		if [[ $group == "('Vietnamese', 'unikey',"* ]]; then
			# Future contexts must also start in the requested mode. Activate()
			# only changes an existing context; it is a no-op without one.
			ini_set "$config_dir/fcitx5/config" Behavior ActiveByDefault True
			run fcitx5-remote -r
			run fcitx5-remote -o
			printf 'vi\n' | write_file "$directory/language"
			return
		fi
		sleep 0.1
	done
	fail 'Vietnamese Telex did not become active'
}
select_language() {
	local language=$1
	case $language in
	bg)
		stop_input
		[[ $kind != hyprland ]] || run hyprctl switchxkblayout all 1 >/dev/null
		;;
	en)
		read_secondary
		if [[ $selected == vi ]] && fcitx_running; then
			ini_set "$config_dir/fcitx5/config" Behavior ActiveByDefault False
			run fcitx5-remote -r
			run fcitx5-remote -c
			printf 'en\n' | write_file "$directory/language"
		elif [[ $kind == hyprland ]]; then
			run hyprctl switchxkblayout all 0 >/dev/null
		fi
		;;
	vi)
		vietnamese_available || fail 'Install hardware/keyboard/input-method/vn for Vietnamese Telex'
		read_secondary
		if [[ $selected != vi ]] || ! fcitx_running; then
			stop_input
			configure "$kind"
			rollback=true
			printf 'vi\n' | write_file "$directory/secondary"
			if [[ $kind == hyprland ]]; then
				hypr_config vi
				run systemctl --user start system-vietnamese.service
			else
				# KWin compares Exec strings; a unique token restarts its idle
				# login launcher even if the desktop entry was selected before.
				write_file "$config_dir/fcitx5/kwin.desktop" <<ENTRY
[Desktop Entry]
Type=Application
Name=Vietnamese Telex (on demand)
Exec=/usr/local/bin/system-input-method kwin-launch $(date +%s%N)
NoDisplay=true
X-KDE-Wayland-VirtualKeyboard=true
ENTRY
				kwin_method "$config_dir/fcitx5/kwin.desktop" >/dev/null
			fi
			local attempt
			for ((attempt = 0; attempt < 50; attempt++)); do
				fcitx_running && break
				sleep 0.1
			done
			fcitx_running || fail 'Fcitx did not start'
		fi
		if [[ $kind == plasma ]]; then
			run gdbus call --session --dest org.kde.keyboard --object-path /Layouts \
				--method org.kde.KeyboardLayouts.setLayout 0 >/dev/null
		fi
		activate_vietnamese
		rollback=false
		;;
	*) fail 'select requires en, bg or vi' ;;
	esac
}
status() {
	read_secondary
	local language=en active=false available=false state
	if vietnamese_available; then available=true; fi
	if [[ $selected == vi ]]; then
		if fcitx_running; then
			active=true
			state=$(run fcitx5-remote)
			case $state in
			2) language='vi' ;;
			0)
				# Keep the selected mode while no client has a text context.
				if [[ -r $directory/language ]]; then IFS= read -r language <"$directory/language" || true; fi
				;;
			esac
		fi
	elif [[ $kind == hyprland ]]; then
		# Alt+Shift changes the keyboard that received the keys, which need
		# not be the compositor's "main" keyboard (e.g. laptop + USB keyboard).
		language=$(run hyprctl -j devices | jq -r --arg keyboard "${1:-}" '
			.keyboards | ((map(select(.name == $keyboard)) + map(select(.main)) + .)[0] // {}) |
			if .active_layout_index != null then
				.active_layout_index as $index |
				if ((.layout // "us") | split(",")[$index]) == "bg" then "bg" else "en" end
			elif ((.active_keymap // "") | ascii_downcase | contains("bulgarian")) then "bg" else "en" end')
	fi
	printf '{"available":%s,"secondary":"%s","language":"%s","running":%s}\n' "$available" "$selected" "$language" "$active"
}

args=()
for argument in "$@"; do
	if [[ $argument == --notify ]]; then notify=true; else args+=("$argument"); fi
done
action=${args[0]:-help}
case $action in
configure) configure "${args[1]:-}" ;;
select | status | kwin-launch)
	find_session
	if [[ $action == kwin-launch ]]; then
		# Login invokes this too. The new KWin instance has no opt-in marker.
		read_secondary
		if [[ $kind == plasma && $selected == vi ]]; then exec fcitx5; fi
	elif [[ $action == select ]]; then
		mkdir -p -- "$directory"
		exec 9>"$directory/lock"
		flock -x 9
		select_language "${args[1]:-}"
		status
	else
		status "${args[1]:-}"
	fi
	;;
help | --help | -h)
	printf 'Usage: system-input-method {configure plasma|hyprland | select en|bg|vi [--notify] | status}\n'
	;;
*) fail "Unknown input-method action: $action" ;;
esac
