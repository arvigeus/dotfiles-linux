#!/usr/bin/env bash
set -Eeuo pipefail

DGPU_PCI_ID=1002:73ef

die() {
	printf 'system-g14-observe: %s\n' "$*" >&2
	exit 2
}

section() {
	printf '\n[%s]\n' "$1"
}

read_file() {
	[[ -r $1 ]] && command cat -- "$1" 2>/dev/null || true
}

run_report() {
	local title=$1 command_name=$2
	shift 2
	printf '%s:\n' "$title"
	if ! command -v "$command_name" >/dev/null; then
		printf '  unavailable (%s is not installed)\n' "$command_name"
		return 0
	fi
	timeout 10s "$command_name" "$@" 2>&1 | sed 's/^/  /' || true
}

find_battery() {
	local supply
	for supply in /sys/class/power_supply/*; do
		[[ $(read_file "$supply/type") == Battery ]] || continue
		printf '%s\n' "$supply"
		return 0
	done
	return 1
}

ac_online_status() {
	local supply type online seen=0
	for supply in /sys/class/power_supply/*; do
		type=$(read_file "$supply/type")
		[[ $type == Mains || $type == USB || $type == USB_C ]] || continue
		[[ -r $supply/online ]] || continue
		seen=1
		online=$(read_file "$supply/online")
		if [[ $online == 1 ]]; then
			printf '1'
			return 0
		fi
	done
	((seen == 0)) || printf '0'
}

find_pci_device() {
	local wanted=${1,,} device vendor_id device_id
	for device in /sys/bus/pci/devices/*; do
		vendor_id=$(read_file "$device/vendor")
		device_id=$(read_file "$device/device")
		vendor_id=${vendor_id#0x}
		device_id=${device_id#0x}
		[[ ${vendor_id,,}:${device_id,,} == "$wanted" ]] || continue
		printf '%s\n' "$device"
		return 0
	done
	return 1
}

find_hwmon_named() {
	local wanted=$1 hwmon
	for hwmon in /sys/class/hwmon/hwmon*; do
		[[ $(read_file "$hwmon/name") == "$wanted" ]] || continue
		printf '%s\n' "$hwmon"
		return 0
	done
	return 1
}

find_device_hwmon() {
	local device=$1 hwmon
	for hwmon in "$device"/hwmon/hwmon*; do
		[[ -d $hwmon ]] || continue
		printf '%s\n' "$hwmon"
		return 0
	done
	return 1
}

find_labeled_input() {
	local hwmon=$1 kind=$2 wanted=${3,,} label base
	[[ -n $hwmon ]] || return 1
	for label in "$hwmon"/"$kind"*_label; do
		[[ -r $label ]] || continue
		[[ $(read_file "$label" | tr '[:upper:]' '[:lower:]') == *"$wanted"* ]] || continue
		base=${label%_label}
		[[ -r ${base}_input ]] || continue
		printf '%s\n' "${base}_input"
		return 0
	done
	return 1
}

first_input() {
	local hwmon=$1 pattern=$2 input
	[[ -n $hwmon ]] || return 1
	for input in "$hwmon"/$pattern; do
		[[ -r $input ]] || continue
		printf '%s\n' "$input"
		return 0
	done
	return 1
}

read_scaled() {
	local path=${1:-} divisor=$2 value
	[[ -n $path && -r $path ]] || return 0
	value=$(read_file "$path")
	[[ $value =~ ^-?[0-9]+$ ]] || return 0
	awk -v value="$value" -v divisor="$divisor" 'BEGIN { printf "%.3f", value / divisor }'
}

battery_energy_wh() {
	local battery=$1 energy charge voltage
	energy=$(read_scaled "$battery/energy_now" 1000000)
	if [[ -n $energy ]]; then
		printf '%s' "$energy"
		return
	fi
	charge=$(read_file "$battery/charge_now")
	voltage=$(read_file "$battery/voltage_now")
	[[ $charge =~ ^[0-9]+$ && $voltage =~ ^[0-9]+$ ]] || return 0
	awk -v charge="$charge" -v voltage="$voltage" \
		'BEGIN { printf "%.3f", charge * voltage / 1000000000000 }'
}

battery_power_w() {
	local battery=$1 power current voltage
	power=$(read_scaled "$battery/power_now" 1000000)
	if [[ -n $power ]]; then
		printf '%s' "$power"
		return
	fi
	current=$(read_file "$battery/current_now")
	voltage=$(read_file "$battery/voltage_now")
	[[ $current =~ ^-?[0-9]+$ && $voltage =~ ^[0-9]+$ ]] || return 0
	awk -v current="$current" -v voltage="$voltage" \
		'BEGIN { value = current * voltage / 1000000000000; if (value < 0) value = -value; printf "%.3f", value }'
}

average_cpu_mhz() {
	local frequency files=(/sys/devices/system/cpu/cpufreq/policy*/scaling_cur_freq)
	((${#files[@]} > 0)) || return 0
	frequency=$(awk '{ total += $1; count++ } END { if (count) printf "%.0f", total / count / 1000 }' \
		"${files[@]}" 2>/dev/null || true)
	printf '%s' "$frequency"
}

snapshot() {
	local active_probes=${1:-true}
	local file supply battery dgpu render_nodes=()
	section system
	printf 'kernel: %s\n' "$(uname -srmo)"
	for file in sys_vendor product_name product_version board_name bios_version; do
		printf '%s: %s\n' "$file" "$(read_file "/sys/class/dmi/id/$file")"
	done
	printf 'cmdline: %s\n' "$(read_file /proc/cmdline)"

	section services
	for file in asusd.service asus-shutdown.service switcheroo-control.service \
		power-profiles-daemon.service tuned.service tuned-ppd.service \
		lactd.service cardwired.service zephyrusctl.timer; do
		printf '%-34s active=%-10s enabled=%s\n' "$file" \
			"$(systemctl is-active "$file" 2>/dev/null || true)" \
			"$(systemctl is-enabled "$file" 2>/dev/null || true)"
	done

	section asus
	run_report 'supported interfaces' asusctl info --show-supported
	run_report 'available profiles' asusctl profile list
	run_report 'profile policy' asusctl profile get
	run_report 'profile tuning' asusctl profile tuning
	run_report 'firmware attributes' asusctl armoury list

	section cpu
	printf 'platform_profile: %s\n' "$(read_file /sys/firmware/acpi/platform_profile)"
	printf 'platform_profile_choices: %s\n' "$(read_file /sys/firmware/acpi/platform_profile_choices)"
	printf 'amd_pstate: %s\n' "$(read_file /sys/devices/system/cpu/amd_pstate/status)"
	printf 'boost: %s\n' "$(read_file /sys/devices/system/cpu/cpufreq/boost)"
	printf 'energy_performance_preferences:\n'
	for file in /sys/devices/system/cpu/cpufreq/policy*/energy_performance_preference; do
		[[ -r $file ]] || continue
		printf '  %s=%s\n' "${file%/*}" "$(read_file "$file")"
	done | sort -u

	section graphics
	dgpu=$(find_pci_device "$DGPU_PCI_ID" || true)
	if [[ -n $dgpu ]]; then
		printf 'preferred_dgpu: %s (%s)\n' "${dgpu##*/}" "$DGPU_PCI_ID"
		for file in control runtime_status runtime_suspended_time autosuspend_delay_ms; do
			printf 'power/%s: %s\n' "$file" "$(read_file "$dgpu/power/$file")"
		done
		if command -v lspci >/dev/null; then
			lspci -s "${dgpu##*/}" -nnk 2>/dev/null || true
		fi
	else
		printf 'preferred_dgpu: unavailable (%s not enumerated)\n' "$DGPU_PCI_ID"
	fi
	run_report 'switcheroo devices' switcherooctl list
	render_nodes=(/dev/dri/renderD*)
	if command -v fuser >/dev/null && [[ -e ${render_nodes[0]:-} ]]; then
		printf 'DRM render-node users:\n'
		fuser -v "${render_nodes[@]}" 2>&1 | sed 's/^/  /' || true
	fi

	section displays
	for file in /sys/class/drm/card*-*/status; do
		[[ -r $file ]] || continue
		printf '%s: %s\n' "${file%/status}" "$(read_file "$file")"
	done
	for file in /sys/class/backlight/*/brightness; do
		[[ -r $file ]] || continue
		printf '%s: brightness=%s max=%s\n' "${file%/brightness}" \
			"$(read_file "$file")" "$(read_file "${file%/brightness}/max_brightness")"
	done
	run_report 'KScreen state' kscreen-doctor -j
	if [[ $active_probes == true ]]; then
		run_report 'DRM capabilities' drm_info -j
	else
		printf 'DRM capabilities: active probe skipped\n'
	fi

	section battery
	battery=$(find_battery || true)
	if [[ -n $battery ]]; then
		printf 'device: %s\n' "${battery##*/}"
		for file in status capacity energy_now energy_full energy_full_design \
			charge_now charge_full charge_full_design power_now current_now voltage_now \
			charge_control_end_threshold cycle_count; do
			[[ -r $battery/$file ]] || continue
			printf '%s: %s\n' "$file" "$(read_file "$battery/$file")"
		done
		printf 'calculated_energy_now_wh: %s\n' "$(battery_energy_wh "$battery")"
		printf 'calculated_power_w: %s\n' "$(battery_power_w "$battery")"
	else
		printf 'battery: unavailable\n'
	fi
	for supply in /sys/class/power_supply/*; do
		[[ -r $supply/online ]] || continue
		printf '%s_online: %s\n' "${supply##*/}" "$(read_file "$supply/online")"
	done

	section video
	if [[ $active_probes == true ]]; then
		run_report 'VA-API capabilities' vainfo
		run_report 'Vulkan summary' vulkaninfo --summary
	else
		printf 'GPU API capabilities: active probes skipped (probing may wake a GPU)\n'
	fi

	section processes
	ps -eo pid,comm,%cpu,%mem --sort=-%cpu | head -n 20
}

summarize_csv() {
	awk -F, '
		function numeric(v) { return v ~ /^-?[0-9]+([.][0-9]+)?$/ }
		function remember_max(v, name) {
			if (!numeric(v)) return
			if (!(name in maximum) || v > maximum[name]) maximum[name] = v
		}
		NR == 1 { next }
		{
			samples++
			if (numeric($6)) {
				if (!energy_seen) { first_energy = $6; energy_seen = 1 }
				last_energy = $6
			}
			if (numeric($7) && $7 > 0) { battery_power += $7; battery_power_samples++ }
			if ($13 == "active") dgpu_active++
			remember_max($11, "cpu_temp")
			remember_max($14, "gpu_edge")
			remember_max($15, "gpu_junction")
			remember_max($16, "gpu_power")
		}
		END {
			printf "samples: %d\n", samples
			if ("cpu_temp" in maximum) printf "max_cpu_temp_c: %.1f\n", maximum["cpu_temp"]
			if ("gpu_edge" in maximum) printf "max_dgpu_edge_c: %.1f\n", maximum["gpu_edge"]
			if ("gpu_junction" in maximum) printf "max_dgpu_junction_c: %.1f\n", maximum["gpu_junction"]
			if ("gpu_power" in maximum) printf "max_dgpu_power_w: %.1f\n", maximum["gpu_power"]
			if (samples) printf "dgpu_active_samples: %d/%d (%.1f%%)\n", dgpu_active, samples, 100 * dgpu_active / samples
			if (battery_power_samples) {
				average = battery_power / battery_power_samples
				printf "average_battery_power_w: %.2f\n", average
				if (energy_seen && average > 0) printf "estimated_hours_at_last_energy: %.2f\n", last_energy / average
			}
			if (energy_seen) printf "measured_energy_change_wh: %.3f\n", first_energy - last_energy
		}
	' "$1"
}

record() {
	local duration=900 interval=5 label=observation output=''
	while (($# > 0)); do
		case $1 in
		--duration) duration=${2:-}; shift 2 ;;
		--interval) interval=${2:-}; shift 2 ;;
		--label) label=${2:-}; shift 2 ;;
		--output) output=${2:-}; shift 2 ;;
		*) die "unknown record argument: $1" ;;
		esac
	done
	[[ $duration =~ ^[0-9]+$ && $duration -ge 1 && $duration -le 86400 ]] ||
		die '--duration must be 1..86400 seconds'
	[[ $interval =~ ^[0-9]+$ && $interval -ge 1 && $interval -le 60 ]] ||
		die '--interval must be 1..60 seconds'
	[[ $label =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] ||
		die '--label must contain only letters, digits, dot, underscore, or dash'
	if [[ -z $output ]]; then
		output="${XDG_STATE_HOME:-$HOME/.local/state}/system/g14-observations/$(date -u +%Y%m%dT%H%M%SZ)-$label"
	fi
	mkdir -p -- "$output"

	local battery dgpu cpu_hwmon asus_hwmon dgpu_hwmon
	local cpu_temp cpu_fan gpu_edge gpu_junction gpu_power gpu_fan
	battery=$(find_battery || true)
	dgpu=$(find_pci_device "$DGPU_PCI_ID" || true)
	cpu_hwmon=$(find_hwmon_named k10temp || true)
	asus_hwmon=$(find_hwmon_named asus || true)
	dgpu_hwmon=''
	[[ -z $dgpu ]] || dgpu_hwmon=$(find_device_hwmon "$dgpu" || true)
	cpu_temp=$(find_labeled_input "$cpu_hwmon" temp tctl || first_input "$cpu_hwmon" 'temp*_input' || true)
	cpu_fan=$(find_labeled_input "$asus_hwmon" fan cpu || first_input "$asus_hwmon" 'fan1_input' || true)
	gpu_edge=$(find_labeled_input "$dgpu_hwmon" temp edge || first_input "$dgpu_hwmon" 'temp1_input' || true)
	gpu_junction=$(find_labeled_input "$dgpu_hwmon" temp junction || first_input "$dgpu_hwmon" 'temp2_input' || true)
	gpu_power=$(find_labeled_input "$dgpu_hwmon" power average || first_input "$dgpu_hwmon" 'power1_average' || true)
	gpu_fan=$(find_labeled_input "$asus_hwmon" fan gpu || first_input "$asus_hwmon" 'fan2_input' || true)

	# Do not run DRM/VA-API/Vulkan capability probes around a measurement.
	# Opening a render node can wake the dGPU and invalidate a battery baseline.
	snapshot false >"$output/metadata-before.txt"
	ps -eo pid,comm,%cpu,%mem --sort=-%cpu >"$output/processes-before.txt"
	local csv="$output/samples.csv"
	printf '%s\n' 'timestamp,elapsed_s,ac_online,battery_status,battery_capacity_pct,battery_energy_now_wh,battery_power_w,platform_profile,cpu_boost,cpu_avg_mhz,cpu_temp_c,cpu_fan_rpm,dgpu_runtime,dgpu_edge_c,dgpu_junction_c,dgpu_power_w,dgpu_fan_rpm' >"$csv"

	printf 'Recording %s for %ss every %ss\n' "$label" "$duration" "$interval"
	printf 'Output: %s\n' "$output"
	local start=$SECONDS stop_requested=0 samples=0
	trap 'stop_requested=1' INT TERM
	while ((SECONDS - start < duration && stop_requested == 0)); do
		local elapsed timestamp ac_online battery_status capacity energy battery_power
		local profile boost cpu_mhz cpu_temp_c cpu_fan_rpm dgpu_runtime
		local gpu_edge_c gpu_junction_c gpu_power_w gpu_fan_rpm
		elapsed=$((SECONDS - start))
		timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
		ac_online=$(ac_online_status)
		battery_status=''; capacity=''; energy=''; battery_power=''
		if [[ -n $battery ]]; then
			battery_status=$(read_file "$battery/status")
			capacity=$(read_file "$battery/capacity")
			energy=$(battery_energy_wh "$battery")
			battery_power=$(battery_power_w "$battery")
		fi
		profile=$(read_file /sys/firmware/acpi/platform_profile)
		boost=$(read_file /sys/devices/system/cpu/cpufreq/boost)
		cpu_mhz=$(average_cpu_mhz)
		cpu_temp_c=$(read_scaled "$cpu_temp" 1000)
		cpu_fan_rpm=$(read_file "$cpu_fan")
		dgpu_runtime='unavailable'; [[ -z $dgpu ]] || dgpu_runtime=$(read_file "$dgpu/power/runtime_status")
		gpu_edge_c=''; gpu_junction_c=''; gpu_power_w=''; gpu_fan_rpm=''
		# Reading amdgpu hwmon may resume a suspended device. Only sample these
		# nodes when runtime PM already says the dGPU is active.
		if [[ $dgpu_runtime == active ]]; then
			gpu_edge_c=$(read_scaled "$gpu_edge" 1000)
			gpu_junction_c=$(read_scaled "$gpu_junction" 1000)
			gpu_power_w=$(read_scaled "$gpu_power" 1000000)
			gpu_fan_rpm=$(read_file "$gpu_fan")
		fi
		printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
			"$timestamp" "$elapsed" "$ac_online" "$battery_status" "$capacity" \
			"$energy" "$battery_power" "$profile" "$boost" "$cpu_mhz" \
			"$cpu_temp_c" "$cpu_fan_rpm" "$dgpu_runtime" "$gpu_edge_c" \
			"$gpu_junction_c" "$gpu_power_w" "$gpu_fan_rpm" >>"$csv"
		samples=$((samples + 1))
		printf '\r%-5ss CPU=%-7s dGPU=%-7s/%-7s battery=%-7sW dGPU-state=%-10s' \
			"$elapsed" "${cpu_temp_c:-?}" "${gpu_edge_c:-?}" \
			"${gpu_junction_c:-?}" "${battery_power:-?}" "${dgpu_runtime:-?}"
		((stop_requested == 0)) || break
		sleep "$interval" || true
	done
	trap - INT TERM
	printf '\n'
	ps -eo pid,comm,%cpu,%mem --sort=-%cpu >"$output/processes-after.txt"
	snapshot false >"$output/metadata-after.txt"
	if command -v journalctl >/dev/null; then
		journalctl --no-pager -b -k -n 500 >"$output/kernel-log-tail.txt" 2>&1 || true
	fi
	summarize_csv "$csv" | tee "$output/summary.txt"
	printf 'Observation complete: %s (%s samples)\n' "$output" "$samples"
}

usage() {
	cat <<'EOF'
Usage:
  system-g14-observe snapshot
  system-g14-observe snapshot --active-probes
  system-g14-observe record [--label NAME] [--duration SEC] [--interval SEC]
                            [--output DIRECTORY]

This tool only reads system state. Run it without sudo while reproducing a
real workload; it does not start a stress test or change a power setting.
EOF
}

snapshot_cli() {
	case ${1:-} in
	'') snapshot false ;;
	--active-probes)
		(($# == 1)) || die 'snapshot --active-probes accepts no further arguments'
		snapshot true
		;;
	*) die "unknown snapshot argument: $1" ;;
	esac
}

case ${1:-} in
snapshot) shift; snapshot_cli "$@" ;;
record) shift; record "$@" ;;
-h | --help | help | '') usage ;;
*) die "unknown command: $1" ;;
esac
