#!/usr/bin/env bash
# Native mutable-system updater implementing the SteamOS client protocol.
set -uo pipefail

check=false
supports_duplicate_detection=false
while (($# > 0)); do
	case $1 in
	check) check=true ;;
	--supports-duplicate-detection) supports_duplicate_detection=true ;;
	esac
	shift
done

[[ $supports_duplicate_detection == false ]] || exit 0

if ((EUID != 0)); then
	if [[ $check == true ]]; then
		exec pkexec --disable-internal-agent "$(realpath "$0")" check
	else
		exec pkexec --disable-internal-agent "$(realpath "$0")"
	fi
fi

# Do not race a terminal-driven native update or another Steam client request.
exec 9>/run/dotfiles-native-update.lock
flock -n 9 || {
	printf 'Another native system update is already running.\n' >&2
	exit 7
}

# shellcheck source=/etc/os-release
source /etc/os-release

arch_check() {
	local repo_output repo_status aur_output aur_status total=0
	repo_output=$(checkupdates 2>/dev/null)
	repo_status=$?
	case $repo_status in
	0) total=$((total + $(wc -l <<<"$repo_output"))) ;;
	2) ;;
	*)
		printf 'Could not check Arch repositories for updates.\n' >&2
		return 7
		;;
	esac

	aur_output=$(sudo --user dotfiles-aur \
		env HOME=/home/dotfiles-aur \
		paru -Qua --devel --color never 2>/dev/null)
	aur_status=$?
	case $aur_status in
	0)
		[[ -z $aur_output ]] || total=$((total + $(wc -l <<<"$aur_output")))
		;;
	1) ;; # paru reports no AUR updates with status 1 and no output.
	*)
		printf 'Could not check the AUR for updates.\n' >&2
		return 7
		;;
	esac

	((total > 0)) || return 7
	printf 'Upgrade:\u00a0%d\u00a0Packages\n' "$total"
}

fedora_check() {
	dnf -q check-upgrade --refresh >/dev/null 2>&1
	local status=$?
	case $status in
	100)
		printf 'Upgrade:\u00a0Packages available\n'
		return 0
		;;
	0) return 7 ;;
	*)
		printf 'Could not check Fedora repositories for updates.\n' >&2
		return 7
		;;
	esac
}

case $ID in
arch)
	if [[ $check == true ]]; then
		arch_check
		exit $?
	fi
	sudo --user dotfiles-aur \
		env HOME=/home/dotfiles-aur \
		paru --noconfirm --needed --skipreview --noupgrademenu --devel -Syu
	status=$?
	/usr/local/libexec/dotfiles/restore-gaming-session-overrides || exit $?
	((status == 0)) || exit "$status"
	exit 7
	;;
fedora)
	if [[ $check == true ]]; then
		fedora_check
		exit $?
	fi
	dnf -y upgrade --refresh
	status=$?
	/usr/local/libexec/dotfiles/restore-gaming-session-overrides || exit $?
	((status == 0)) || exit "$status"
	# This is also a fallback for transactions where kernel-install was not
	# called. It atomically refreshes the current slot's direct-boot UKI.
	/usr/local/libexec/dotfiles-refresh-uki || exit $?
	exit 7
	;;
*)
	printf 'Unsupported distribution for native update: %s\n' "$ID" >&2
	exit 7
	;;
esac
