# Maintainer: system project contributors

pkgname=steamos-manager-powerstation
_commit=5438d605296ae5b5ecc031760cc80d5f4675f7d8
pkgver=0.20260819.r5438d60
pkgrel=1
pkgdesc='SteamOS Manager with PowerStation and OGC Gamescope-session integration'
arch=('x86_64')
url='https://github.com/OpenGamingCollective/steamos-manager'
license=('MIT')
depends=(
	'dbus'
	'gamescope-session-ogui-steam-git'
	'gcc-libs'
	'glibc'
	'powerstation'
	'speech-dispatcher'
	'systemd'
	'wireless_tools'
)
makedepends=('cargo' 'clang')
provides=('steamos-manager')
conflicts=('steamos-manager')
source=("$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('fbfa27e66b18fce7aaa4c4c5af6da08b97391916b1def31ebcb321c3c0be651c')

prepare() {
	cd "steamos-manager-$_commit"
	# steamos-log-submitter is a SteamOS/Bazzite service, not an Arch dependency.
	sed -i \
		-e '/^Wants=steamos-log-submitter\.service$/d' \
		-e '/^After=steamos-log-submitter\.service$/d' \
		data/system/steamos-manager.service
	cargo fetch --locked
}

build() {
	cd "steamos-manager-$_commit"
	make CARGOFLAGS=--frozen build
}

package() {
	cd "steamos-manager-$_commit"
	make DESTDIR="$pkgdir" install
	rm -f \
		"$pkgdir/usr/lib/systemd/user/orca.service" \
		"$pkgdir/usr/share/licenses/steamos-manager/LICENSE"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

	install -d \
		"$pkgdir/usr/lib/systemd/user/gamescope-session-plus@ogui-steam.service.wants"
	ln -s ../steamos-manager.service \
		"$pkgdir/usr/lib/systemd/user/gamescope-session-plus@ogui-steam.service.wants/steamos-manager.service"
}
