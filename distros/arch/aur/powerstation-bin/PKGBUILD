# Maintainer: dotfiles-linux contributors

pkgname=powerstation-bin
_pkgname=powerstation
pkgver=0.8.1
pkgrel=1
pkgdesc='Open source performance-management daemon with a D-Bus interface'
arch=('x86_64')
url='https://github.com/ShadowBlip/PowerStation'
license=('GPL-3.0-only')
depends=('dbus' 'pciutils')
provides=('powerstation')
conflicts=('powerstation-git')
options=('!strip')
source=(
	"$_pkgname-v$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/powerstation-x86_64.tar.gz"
	"LICENSE-v$pkgver::$url/raw/v$pkgver/LICENSE"
)
sha256sums=(
	'71e920da0d4c28e804de74546ba971f951f928b228761ab3e24ba1b2b8842107'
	'e57f1c320b8cf8798a7d2ff83a6f9e06a33a03585f6e065fea97f1d86db84052'
)

package() {
	cp -a "$srcdir/$_pkgname/usr" "$pkgdir/"
	install -Dm644 "$srcdir/LICENSE-v$pkgver" \
		"$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
