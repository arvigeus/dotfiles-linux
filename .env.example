# Copy to .env. This file is sourced by Bash.

# bootstrap.sh ERASES this disk. Partitions 1 (EFI) and 2 (LUKS) are used.
DISK=/dev/vda

HOSTNAME=workstation
USERNAME=alice
TIMEZONE=UTC
KEYMAP=us

# VM testing. Leave empty when installing physical hardware.
SOURCE_ISO=

# Usually auto-detected. Uncomment if your distribution stores OVMF elsewhere.
# OVMF_CODE=/usr/share/edk2/x64/OVMF_CODE.4m.fd
# OVMF_VARS_TEMPLATE=/usr/share/edk2/x64/OVMF_VARS.4m.fd
