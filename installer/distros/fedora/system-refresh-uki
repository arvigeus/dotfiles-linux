#!/usr/bin/env bash
# Atomically rebuild the direct-boot UKI for the running Fedora A/B slot.
set -Eeuo pipefail

((EUID == 0)) || {
	printf 'system-refresh-uki must run as root.\n' >&2
	exit 1
}

slot_root=$(findmnt -n -o FSROOT / 2>/dev/null || true)
case $slot_root in
/@root-a | @root-a) letter=a ;;
/@root-b | @root-b) letter=b ;;
*)
	root_options=$(awk '$2 == "/" { print $4; exit }' /etc/fstab)
	case ,$root_options, in
	*,subvol=@root-a,*) letter=a ;;
	*,subvol=@root-b,*) letter=b ;;
	*)
		printf 'Cannot determine the running system A/B slot.\n' >&2
		exit 1
		;;
	esac
	;;
esac

kernel_version=${1:-}
if [[ -z $kernel_version || ! -d /usr/lib/modules/$kernel_version ]]; then
	kernel_version=$(find /usr/lib/modules -mindepth 1 -maxdepth 1 -type d \
		-printf '%f\n' | sort -V | tail -n 1)
fi
[[ -n $kernel_version ]] || {
	printf 'Cannot find an installed Fedora kernel.\n' >&2
	exit 1
}

kernel_image="/usr/lib/modules/$kernel_version/vmlinuz"
[[ -f $kernel_image ]] || kernel_image="/boot/vmlinuz-$kernel_version"
[[ -f $kernel_image ]] || {
	printf 'Kernel image not found for %s.\n' "$kernel_version" >&2
	exit 1
}

cmdline=$(</etc/kernel/cmdline)
destination="/efi/EFI/Linux/system-$letter.efi"
temporary="/efi/EFI/Linux/.system-$letter.in-place.tmp.efi"
trap 'rm -f -- "$temporary"' EXIT

mkdir -p /efi/EFI/Linux
dracut \
	--force \
	--no-hostonly \
	--add "crypt btrfs systemd systemd-initrd i18n" \
	--uefi \
	--ukify \
	--kernel-image "$kernel_image" \
	--kernel-cmdline "$cmdline" \
	"$temporary" \
	"$kernel_version"
mv -f -- "$temporary" "$destination"
sync -f "$destination"
